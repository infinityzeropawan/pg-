{
  "functions": {
    "api/*.ts": {
      "includeFiles": [
        "node_modules/express/**",
        "node_modules/@prisma/client/**",
        "node_modules/.prisma/client/**",
        "node_modules/cors/**",
        "node_modules/helmet/**",
        "node_modules/bcryptjs/**",
        "node_modules/jsonwebtoken/**",
        "node_modules/express-rate-limit/**",
        "node_modules/dotenv/**"
      ]
    },
    "backend/src/index.ts": {
      "includeFiles": [
        "node_modules/express/**",
        "node_modules/@prisma/client/**",
        "node_modules/.prisma/client/**",
        "node_modules/cors/**",
        "node_modules/helmet/**",
        "node_modules/bcryptjs/**",
        "node_modules/jsonwebtoken/**",
        "node_modules/express-rate-limit/**",
        "node_modules/dotenv/**"
      ]
    }
  },
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/api/backend(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
