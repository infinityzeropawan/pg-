{
  "functions": {
    "api/*.ts": {
      "includeFiles": "node_modules/{express,@prisma/client,.prisma/client,cors,helmet,bcryptjs,jsonwebtoken,express-rate-limit,dotenv}/**"
    },
    "backend/src/index.ts": {
      "includeFiles": "node_modules/{express,@prisma/client,.prisma/client,cors,helmet,bcryptjs,jsonwebtoken,express-rate-limit,dotenv}/**"
    }
  },
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/api/backend(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
