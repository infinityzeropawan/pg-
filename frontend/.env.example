# ─────────────────────────────────────────────────────────────
# Frontend (Next.js)
# Copy to `.env.local` for local development. In production set
# these in your Vercel project settings (they are BUILD-TIME values,
# so they must be present before `next build` runs).
# ─────────────────────────────────────────────────────────────

# ── Backend API base URL ────────────────────────────────────
# Absolute origin of the Express backend, OR leave empty to use
# same-origin requests (works with the monorepo `vercel.json` rewrites
# that route /api/v1 -> the backend service).
#
#   Monorepo (single Vercel project):      leave empty
#   Two separate Vercel projects:          https://smart-pg-backend.vercel.app
#
# NOTE: this value is inlined into the client bundle at build time.
# Changing it requires a rebuild/redeploy to take effect.
NEXT_PUBLIC_API_URL=

# ── App environment ─────────────────────────────────────────
# One of: development | staging | production
NEXT_PUBLIC_APP_ENV=development
