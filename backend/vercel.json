{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/express/**",
          "node_modules/@prisma/client/**",
          "node_modules/.prisma/client/**",
          "node_modules/cors/**",
          "node_modules/helmet/**",
          "node_modules/bcryptjs/**",
          "node_modules/jsonwebtoken/**",
          "node_modules/express-rate-limit/**",
          "node_modules/dotenv/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ]
}
