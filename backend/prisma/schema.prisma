// Smart PG Management — Canonical Database Schema (Prisma)
// Multi-tenant PG & Hostel SaaS Platform

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  SUPERADMIN
  OWNER
  MANAGER
  STAFF
  STUDENT
  PARENT
}

enum OwnerRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PropertyType {
  BOYS_PG
  GIRLS_PG
  COED_PG
  HOSTEL
  COLIVING
}

enum RoomType {
  SINGLE
  DOUBLE_SHARING
  TRIPLE_SHARING
  FOUR_SHARING
  DORMITORY
}

enum BedStatus {
  VACANT
  OCCUPIED
  UNDER_MAINTENANCE
  RESERVED
}

enum StayStatus {
  BOOKED
  CHECKED_IN
  ACTIVE
  NOTICE_PERIOD
  CHECKED_OUT
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  RAZORPAY
  CASHFREE
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
}

enum SOSStatus {
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED
  FALSE_ALARM
}

enum VerificationStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

enum DocumentType {
  AADHAAR
  PAN
  POLICE_VERIFICATION
  RENT_AGREEMENT
  COLLEGE_ID
  EMPLOYMENT_ID
  OTHER
}

// ==========================================
// 1. ACCOUNTS & AUTHENTICATION
// ==========================================

model User {
  id                    String        @id @default(uuid())
  email                 String        @unique
  phone                 String        @unique
  passwordHash          String
  fullName              String
  role                  UserRole
  isActive              Boolean       @default(true)
  isSuspended           Boolean       @default(false)
  mustChangePassword    Boolean       @default(true)
  avatarUrl             String?
  
  // Multi-tenancy Isolation (Owner scoping)
  ownerId               String?
  owner                 User?         @relation("OwnerTenants", fields: [ownerId], references: [id], onDelete: Restrict)
  managedTenants        User[]        @relation("OwnerTenants")

  // Profile relations
  tenantProfile         TenantProfile?
  parentProfile         ParentProfile?
  
  // Assigned properties & activity
  staffAssignments      StaffAssignment[]
  createdProperties     Property[]    @relation("PropertyOwner")
  sessions              UserSession[]
  auditLogs             AuditLog[]    @relation("AuditActor")
  
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([ownerId])
  @@index([role])
  @@index([email, phone])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model OwnerRequest {
  id           String             @id @default(uuid())
  fullName     String
  email        String             @unique
  phone        String             @unique
  city         String
  propertyCount Int               @default(1)
  totalBeds    Int
  notes        String?
  status       OwnerRequestStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  rejectionReason String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  ownerId     String?
  propertyId  String?
  action      String   // e.g., "TENANT_CHECKIN", "INVOICE_GENERATED"
  entityType  String   // e.g., "TenantStay", "Payment"
  entityId    String
  details     String?  // JSON string
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@index([propertyId])
  @@index([actorId])
  @@index([action])
}

// ==========================================
// 2. PLATFORM & SUBSCRIPTIONS
// ==========================================

model PlatformPlan {
  id            String         @id @default(uuid())
  name          String         @unique
  code          String         @unique // e.g., "STARTER", "GROWTH", "ENTERPRISE"
  maxProperties Int
  maxBeds       Int
  priceMonthly  Int            // In Paise (e.g., 299900 = ₹2999)
  priceYearly   Int            // In Paise
  features      String         // JSON string array
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id             String       @id @default(uuid())
  ownerId        String
  planId         String
  plan           PlatformPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean      @default(true)
  autoRenew      Boolean      @default(true)
  paymentStatus  String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([ownerId])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String
  description String?
  isEnabled   Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, ownerId])
}

model PlatformSetting {
  id                    String   @id @default("platform")
  otpEnabled            Boolean  @default(false)
  defaultNightEntryTime String   @default("22:00")
  defaultNoticeDays     Int      @default(30)
  supportPhone          String   @default("+91 9999999999")
  maintenanceMode       Boolean  @default(false)
  whatsappEnabled       Boolean  @default(false)
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SupportTicket {
  id          String   @id @default(uuid())
  ownerId     String?
  title       String
  description String
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN")
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model PlatformBroadcast {
  id          String   @id @default(uuid())
  message     String
  createdBy   String
  createdAt   DateTime @default(now())
}

// ==========================================
// 3. PROPERTY & ROOM HIERARCHY
// ==========================================

model Property {
  id              String         @id @default(uuid())
  ownerId         String
  owner           User           @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name            String
  slug            String         @unique
  type            PropertyType
  address         String
  city            String
  state           String
  pincode         String
  contactPhone    String
  contactEmail    String
  amenities       String         // JSON string
  images          String         // JSON string
  rules           String?
  floors          Floor[]
  staff           StaffAssignment[]
  stays           TenantStay[]
  invoices        Invoice[]
  expenses        Expense[]
  complaints      Complaint[]
  enquiries       Enquiry[]
  attendances     Attendance[]
  visitorLogs     VisitorLog[]
  messMenus       MessMenu[]
  sosAlerts       SOSAlert[]
  gateLogs        GateLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([ownerId])
  @@index([city])
}

model Floor {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floorNumber Int
  name        String
  rooms       Room[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, floorNumber])
}

model Room {
  id          String   @id @default(uuid())
  floorId     String
  floor       Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  roomNumber  String
  type        RoomType
  monthlyRent Int
  beds        Bed[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([floorId, roomNumber])
}

model Bed {
  id          String       @id @default(uuid())
  roomId      String
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedNumber   String
  status      BedStatus    @default(VACANT)
  monthlyRent Int
  stays       TenantStay[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([roomId, bedNumber])
  @@index([status])
}

model StaffAssignment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  permissions String   // JSON string
  createdAt   DateTime @default(now())

  @@unique([userId, propertyId])
}

// ==========================================
// 4. TENANTS, PARENTS & STAYS
// ==========================================

model TenantProfile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyContactName String
  emergencyContactPhone String
  permanentAddress    String
  idProofType         String
  idProofNumber       String
  collegeOrCompany    String?
  policeVerification  PoliceVerification?
  parentProfileId     String?
  parentProfile       ParentProfile?     @relation(fields: [parentProfileId], references: [id], onDelete: SetNull)
  stays               TenantStay[]
  documents           Document[]
  rentAgreements      RentAgreement[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([parentProfileId])
}

model ParentProfile {
  id          String          @id @default(uuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  relation    String
  address     String
  tenants     TenantProfile[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TenantStay {
  id              String           @id @default(uuid())
  ownerId         String
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenantId        String
  tenant          TenantProfile    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bedId           String
  bed             Bed              @relation(fields: [bedId], references: [id], onDelete: Restrict)
  status          StayStatus       @default(BOOKED)
  monthlyRent     Int
  securityDeposit Int
  startDate       DateTime
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  invoices        Invoice[]
  deposits        SecurityDeposit[]
  checkoutRecord  CheckoutRecord?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([ownerId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([bedId])
  @@index([status])
}

model CheckoutRecord {
  id              String     @id @default(uuid())
  stayId          String     @unique
  stay            TenantStay @relation(fields: [stayId], references: [id], onDelete: Cascade)
  inspectionNotes String?
  damageCharges   Int        @default(0)
  unpaidDues      Int        @default(0)
  refundAmount    Int        @default(0)
  checkoutDate    DateTime   @default(now())
  createdAt       DateTime   @default(now())
}

// ==========================================
// 5. FINANCE, INVOICES & PAYMENTS
// ==========================================

model Invoice {
  id             String        @id @default(uuid())
  ownerId        String
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  stayId         String
  stay           TenantStay    @relation(fields: [stayId], references: [id], onDelete: Restrict)
  invoiceNumber  String        @unique
  billingMonth   String
  dueDate        DateTime
  totalAmount    Int
  paidAmount     Int           @default(0)
  status         InvoiceStatus @default(ISSUED)
  items          InvoiceItem[]
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([ownerId])
  @@index([propertyId])
  @@index([stayId])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  title       String
  amount      Int
  createdAt   DateTime @default(now())
}

model Payment {
  id              String        @id @default(uuid())
  ownerId         String
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  transactionRef  String        @unique
  amount          Int
  method          PaymentMethod
  status          PaymentStatus @default(COMPLETED)
  idempotencyKey  String?       @unique
  paidAt          DateTime      @default(now())

  @@index([ownerId])
  @@index([invoiceId])
}

model SecurityDeposit {
  id          String     @id @default(uuid())
  stayId      String
  stay        TenantStay @relation(fields: [stayId], references: [id], onDelete: Cascade)
  amount      Int
  isRefunded  Boolean    @default(false)
  refundDate  DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
}

model Expense {
  id          String   @id @default(uuid())
  ownerId     String
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category    String
  title       String
  amount      Int
  expenseDate DateTime
  receiptUrl  String?
  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@index([propertyId])
}

// ==========================================
// 6. OPERATIONS & COMPLAINTS
// ==========================================

model Enquiry {
  id          String    @id @default(uuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  email       String?
  roomType    RoomType?
  message     String?
  isResolved  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([propertyId])
}

model Complaint {
  id          String            @id @default(uuid())
  ownerId     String
  propertyId  String
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String
  priority    ComplaintPriority @default(MEDIUM)
  status      ComplaintStatus   @default(OPEN)
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([ownerId])
  @@index([propertyId])
  @@index([status])
}

model Attendance {
  id          String           @id @default(uuid())
  propertyId  String
  property    Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId      String
  date        DateTime
  status      AttendanceStatus @default(PRESENT)
  remarks     String?
  createdAt   DateTime         @default(now())

  @@unique([propertyId, userId, date])
}

model VisitorLog {
  id           String    @id @default(uuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  visitorName  String
  visitorPhone String
  tenantId     String?
  purpose      String
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?

  @@index([propertyId])
}

// ==========================================
// 7. MESS & FOOD OPERATIONS
// ==========================================

model MessMenu {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  dayOfWeek   String
  mealType    MealType
  items       String   // JSON string
  createdAt   DateTime @default(now())

  @@unique([propertyId, dayOfWeek, mealType])
}

model MealOrder {
  id          String   @id @default(uuid())
  propertyId  String
  userId      String
  mealType    MealType
  date        DateTime
  rating      Int?
  feedback    String?
  createdAt   DateTime @default(now())

  @@index([propertyId])
}

model MessWallet {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 8. SAFETY & VERIFICATION
// ==========================================

model SOSAlert {
  id          String    @id @default(uuid())
  ownerId     String
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId      String
  latitude    Float?
  longitude   Float?
  status      SOSStatus @default(TRIGGERED)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([propertyId])
  @@index([status])
}

model GateLog {
  id                 String    @id @default(uuid())
  propertyId         String
  property           Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId             String
  studentName        String?
  roomNumber         String?
  type               String    @default("ENTRY")
  entryType          String?
  reason             String?
  destination        String?
  expectedReturnTime String?
  isLate             Boolean   @default(false)
  loggedBy           String?
  passCode           String?
  timestamp          DateTime  @default(now())
  createdAt          DateTime  @default(now())

  @@index([propertyId])
}

model PoliceVerification {
  id              String             @id @default(uuid())
  tenantId        String             @unique
  tenant          TenantProfile      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status          VerificationStatus @default(PENDING)
  documentUrl     String?
  submittedAt     DateTime           @default(now())
  verifiedAt      DateTime?
  remarks         String?
}

// ==========================================
// 9. DOCUMENTS & AGREEMENTS
// ==========================================

model Document {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        DocumentType
  fileUrl     String
  fileName    String
  fileSize    Int
  uploadedAt  DateTime      @default(now())

  @@index([tenantId])
}

model RentAgreement {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agreementUrl   String
  startDate      DateTime
  endDate        DateTime
  isSignedByTenant Boolean    @default(false)
  isSignedByOwner  Boolean    @default(false)
  createdAt      DateTime      @default(now())

  @@index([tenantId])
}

// ==========================================
// 10. NOTIFICATIONS
// ==========================================

model NotificationLog {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  message     String
  isRead      Boolean  @default(false)
  sentAt      DateTime @default(now())

  @@index([userId])
}

// ==========================================
// 11. NOTICES, FOOD MENU & MAINTENANCE
// ==========================================

model Notice {
  id         String   @id @default(uuid())
  ownerId    String
  title      String
  content    String
  category   String   @default("General")
  target     String   @default("ALL")
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ownerId])
}

model FoodMenu {
  id           String   @id @default(uuid())
  ownerId      String   @unique
  weekMenuJson String   @default("{}")
  updatedAt    DateTime @updatedAt
}

model MaintenanceContract {
  id          String   @id @default(uuid())
  ownerId     String
  vendorName  String
  serviceType String
  startDate   DateTime
  endDate     DateTime
  cost        Int
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

// ==========================================
// 12. LEAVES, STAFF TASKS, STOCK & MESS WALLET
// ==========================================

model LeaveRequest {
  id          String   @id @default(uuid())
  studentId   String
  propertyId  String
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String   @default("PENDING")
  approvedBy  String?
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([propertyId])
}

model StaffTask {
  id          String   @id @default(uuid())
  propertyId  String
  assignedTo  String
  title       String
  description String
  priority    String   @default("MEDIUM")
  status      String   @default("PENDING")
  dueDate     DateTime?
  createdAt   DateTime @default(now())

  @@index([propertyId])
  @@index([assignedTo])
}

model StockItem {
  id              String   @id @default(uuid())
  propertyId      String
  itemName        String
  category        String
  currentQuantity Float
  unit            String   @default("kg")
  minThreshold    Float    @default(5.0)
  updatedAt       DateTime @updatedAt

  @@index([propertyId])
}
