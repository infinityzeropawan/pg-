# ─────────────────────────────────────────────────────────────
# Backend (Express + Prisma + Neon PostgreSQL)
# Copy to `.env` for local development. In production set these
# in your hosting provider's environment (Vercel project settings).
# ─────────────────────────────────────────────────────────────

# Node runtime
NODE_ENV=development
PORT=5000

# ── Neon PostgreSQL ─────────────────────────────────────────
# DATABASE_URL should be the POOLED connection string (uses PgBouncer).
# DIRECT_URL should be the DIRECT connection string (used by Prisma Migrate).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ── Auth secrets ────────────────────────────────────────────
# SECURITY: these have NO fallback in production. The server refuses to start
# if they are missing when NODE_ENV=production. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS allow-list ─────────────────────────────────────────
# Comma-separated list of browser origins allowed to call this API.
# MUST be set in production, e.g.:
#   CORS_ORIGINS=https://smartpg.vercel.app,https://www.smartpg.com
# Leave empty for local development (permissive for localhost tooling).
CORS_ORIGINS=
